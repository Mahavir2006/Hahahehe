# CascadeShield Environment Configuration
# Copy to .env and fill in values as needed

# ============================================================================
# LLM Configuration
# ============================================================================
# Set to 'offline' to use deterministic offline provider (default for tests)
# Set to 'anthropic' to use real Anthropic API
LLM_PROVIDER=offline

# Anthropic API key (required only if LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...

# Model name (used by both providers)
LLM_MODEL=claude-3-haiku-20240307

# LLM limits
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_BUDGET_TOKENS_PER_ADVISORY=50000
LLM_BUDGET_CALLS_PER_ADVISORY=20

# Trace raw LLM prompts/responses (set to 'true' for debugging)
TRACE_RAW=false

# ============================================================================
# Chain Configuration
# ============================================================================
# Local Hardhat network (default)
CHAIN_RPC_URL=http://localhost:8545
CHAIN_ID=31337

# Deployment file (generated by deploy.ts)
DEPLOYMENT_FILE=chain/deployments/local.json

# Chain connection settings
CHAIN_CONNECT_TIMEOUT=10
CHAIN_REQUEST_TIMEOUT=60
CHAIN_MAX_RETRIES=5
CHAIN_RETRY_BACKOFF_BASE=1.5

# Gas settings
GAS_PRICE_MULTIPLIER=1.2
GAS_LIMIT_MULTIPLIER=1.3
MAX_GAS_PER_TX=500000

# ============================================================================
# Data Configuration
# ============================================================================
DATA_SEED=42
DATA_DIR=data
DATA_ORGS=power,water,hospital

# ============================================================================
# Agent Configuration
# ============================================================================
# Maximum pipeline concurrency per org node
AGENT_MAX_CONCURRENT_ADVISORIES=20

# Approval request TTL (seconds)
APPROVAL_TTL_SECONDS=3600

# Critic max revision iterations
CRITIC_MAX_ITERATIONS=3

# Risk band thresholds (configurable)
RISK_BAND_LOW_MAX=25
RISK_BAND_MEDIUM_MAX=50
RISK_BAND_HIGH_MAX=75
# Above HIGH_MAX is CRITICAL

# Cascade alert threshold
CASCADE_ALERT_THRESHOLD=0.5

# Supply chain check interval (seconds)
SUPPLY_CHAIN_CHECK_INTERVAL=300

# ============================================================================
# API Configuration
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Dev role header (no real auth in dev)
# X-Dev-Role: org:power|water|hospital|admin

# ============================================================================
# Dashboard Configuration
# ============================================================================
DASHBOARD_PORT=5173
VITE_API_URL=http://localhost:8000
VITE_CHAIN_RPC_URL=http://localhost:8545

# ============================================================================
# Safety / Kill Switch
# ============================================================================
# Admin pause endpoint token (set a random string in production)
ADMIN_PAUSE_TOKEN=dev-pause-token-change-in-prod

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json